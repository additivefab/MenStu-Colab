# 原飞书登录应用，同时用于原身份的通讯录查询及进展提醒；重建群机器人时保留这两项。
# App Secret 只配置在本地或托管平台的加密环境变量中。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 首次启用时，将飞书应用的可用范围仅设为佘阳，再临时改为 true。
# 第一次成功登录会成为管理员；完成后立即改回 false。
FEISHU_ALLOW_FIRST_ADMIN=false

# 首位超级管理员的预绑定飞书 Open ID；只限制一次性人工授予目标，不会在登录时自动提权。
FEISHU_SUPERADMIN_OPEN_ID=
# 可选：已知管理员 Open ID 时使用，比“首位登录”更严格。
FEISHU_ADMIN_OPEN_ID=

# 原应用的事件验证配置，仅在未启用独立机器人时兼容使用。
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 可选：独立群机器人。ID 和 Secret 必须同时配置，站点与长连接 bridge 必须一致。
# 以下四项任一非空即启用独立模式，不会借用原应用的凭据或事件验证配置。
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=
# 长连接无需以下两项；仅启用 webhook 接收时配置新机器人的值。
FEISHU_BOT_VERIFICATION_TOKEN=
FEISHU_BOT_ENCRYPT_KEY=
