{
  "platformUrl": "https://tanyan.example.edu",
  "workerId": "agent-worker-lab01",
  "deployment": "pilot",
  "tokenFile": "/etc/tanyan-agent-worker/worker.token",
  "workRoot": "/var/lib/tanyan-agent-worker/work",
  "profilesDir": "/var/lib/tanyan-agent-worker/profiles",
  "githubBaseUrl": "https://github.com",
  "gitReadFallback": {
    "urlTemplate": "git@github.com:{fullName}.git",
    "sshKeyFile": "/etc/tanyan-agent-worker/deploy_key_readonly",
    "knownHostsFile": "/etc/tanyan-agent-worker/github_known_hosts"
  },
  "pollSeconds": 15,
  "heartbeatSeconds": 30,
  "eventFlushMs": 1000,
  "maxConcurrentAttempts": 2,
  "keepWorkspaces": false,
  "limits": {
    "defaultAgentMinutes": 30,
    "maxAgentMinutes": 120,
    "maxEventsPerAttempt": 2000,
    "cancelGraceSeconds": 20
  },
  "agent": {
    "maxTurns": 60,
    "testCommandPrefixes": ["pytest", "python -m pytest", "python3 -m pytest", "python -m unittest", "python3 -m unittest", "npm test", "npm run test", "node --test", "ruff check", "flake8"]
  },
  "codex": {
    "codexPath": null,
    "childPath": "/usr/local/bin:/usr/bin:/bin"
  },
  "claude": {
    "claudePath": "/usr/local/bin/claude",
    "childPath": "/usr/local/bin:/usr/bin:/bin"
  },
  "isolation": {
    "mode": "container",
    "acceptSharedUidRisk": false,
    "launcher": {
      "argv": [
        "/usr/bin/podman", "run", "--rm", "-i",
        "--network", "tanyan-agent-egress",
        "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--userns", "keep-id",
        "--read-only", "--tmpfs", "/tmp",
        "-v", "{repoDir}:{repoDir}:rw", "-v", "{homeDir}:{homeDir}:rw", "-v", "{tmpDir}:{tmpDir}:rw",
        "-v", "{profileDir}:{profileDir}:rw",
        "-w", "{repoDir}",
        "{envFlags}",
        "localhost/tanyan-agent-runtime@sha256:REPLACE_WITH_IMAGE_DIGEST",
        "{binary}"
      ],
      "envFlag": "--env",
      "binaries": { "codex": "/usr/local/bin/codex", "claude": "/usr/local/bin/claude" },
      "probeNode": "/usr/local/bin/node"
    },
    "egressAllowlist": ["api.openai.com:443", "chatgpt.com:443", "api.anthropic.com:443", "claude.ai:443", "github.com:443", "tanyan.example.edu:443"],
    "probeDeniedHosts": ["1.1.1.1:443", "example.com:80"],
    "rawDataPaths": ["/data", "/srv/datasets"]
  }
}
