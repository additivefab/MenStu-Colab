// Local-only Wrangler config used by `npm run db:migrate:local`.
// It mirrors the D1 binding the dev server builds in vite.config.ts
// (binding DB, placeholder database_id), so Wrangler and the Cloudflare
// Vite plugin resolve the same SQLite file under .wrangler/state.
// Never deploy with this file; it is not the hosted configuration.
{
  "name": "tanyan-local-dev",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../drizzle"
    }
  ]
}
